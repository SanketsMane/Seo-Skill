    "OfferShippingDetails": {"feature": "Shipping details", "status": "active", "required": [], "recommended": ["shippingRate", "shippingDestination", "deliveryTime"]},
    "VacationRental": {"feature": "Vacation rental", "status": "active", "required": ["containsPlace", "identifier", "image", "latitude", "longitude", "name"], "recommended": ["aggregateRating", "address", "brand", "checkinTime", "checkoutTime", "description"]},
    "EmployerAggregateRating": {"feature": "Employer rating", "status": "active", "required": ["itemReviewed", "ratingValue", "ratingCount|reviewCount"], "recommended": ["bestRating", "worstRating"]},
