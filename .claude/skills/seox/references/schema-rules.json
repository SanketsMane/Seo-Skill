    "SiteNavigationElement": {"feature": null, "status": "no-direct-feature", "required": [], "recommended": []},
    "Speakable": {"feature": "Speakable (beta, news, US English)", "status": "limited", "required": [], "recommended": [], "verify": true},
    "EducationalOrganization": {"alias": "Organization"},
