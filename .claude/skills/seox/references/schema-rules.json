{
  "_about": "Google rich-result requirements per Schema.org type. Snapshot - Google changes these. Before telling a user something is or isn't eligible, re-check https://developers.google.com/search/docs/appearance/structured-data/search-gallery. Schema.org itself has NO required properties; 'required' here means 'required for the Google feature'. Update as_of when you edit.",
  "as_of": "2026-10 (compiled from Google Search Central docs; items marked verify=true were uncertain at compile time)",
  "types": {
    "Article": {"feature": "Article", "status": "active", "required": [], "recommended": ["headline", "image", "datePublished", "dateModified", "author"], "nested": {"author": ["name"]}},
    "NewsArticle": {"alias": "Article"},
    "BlogPosting": {"alias": "Article"},
    "Product": {"feature": "Product snippet / Merchant listing", "status": "active", "required": ["name"], "required_one_of": [["offers", "review", "aggregateRating"]], "recommended": ["image", "description", "brand", "sku", "gtin", "offers"], "nested": {"offers": ["price|priceSpecification", "priceCurrency|priceSpecification", "availability"], "aggregateRating": ["ratingValue", "ratingCount|reviewCount"], "review": ["reviewRating", "author"]}},
    "Offer": {"feature": null, "status": "component", "required": [], "recommended": ["price", "priceCurrency", "availability", "url"]},
    "AggregateOffer": {"feature": null, "status": "component", "required": [], "recommended": ["lowPrice", "priceCurrency", "offerCount"]},
    "BreadcrumbList": {"feature": "Breadcrumb", "status": "active", "required": ["itemListElement"], "recommended": [], "list_items": {"key": "itemListElement", "required": ["position", "name"], "recommended": ["item"]}},
    "Organization": {"feature": "Organization (logo/knowledge panel signals)", "status": "active", "required": [], "recommended": ["name", "url", "logo", "sameAs", "contactPoint", "address", "description"]},
    "Corporation": {"alias": "Organization"},
    "NGO": {"alias": "Organization"},
